#!/usr/bin/env bash
# Deploy the working tree into the Omarchy plugin directory.
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEST="$HOME/.config/omarchy/plugins/ssandys.galley"

mkdir -p "$DEST"
rsync -a --delete \
  --exclude '.git' --exclude 'tests' --exclude 'bin' --exclude 'docs' \
  --exclude '__pycache__' --exclude '.pytest_cache' --exclude '.github' \
  --exclude '.superpowers' --exclude '.gitignore' \
  "$SRC/" "$DEST/"

echo "installed -> $DEST"
