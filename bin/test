#!/usr/bin/env bash
# Run every test suite. Python uses stdlib unittest: the active python3 is
# mise-managed and has no pytest.
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SRC"

echo "== manifest =="
jq -e . manifest.json >/dev/null && echo "  valid json"

echo "== bash syntax =="
bash -n bin/install bin/dev-watch bin/test
[ -f scripts/galley_action.sh ] && bash -n scripts/galley_action.sh
echo "  ok"

echo "== python =="
rc=0
python3 -m unittest discover -s tests -p 'test_*.py' -v || rc=$?
# 5 means "no tests collected" (Python 3.12+), which is valid before Task 2
# lands the first suite. Any other non-zero is a real failure.
if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
  exit "$rc"
fi
[ "$rc" -eq 5 ] && echo "  no python tests collected yet"

echo "== javascript =="
if [ -f tests/model.test.js ]; then node --test tests/model.test.js; fi
